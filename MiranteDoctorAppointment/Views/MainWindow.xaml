<Window x:Class="MiranteDoctorAppointment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiranteDoctorAppointment.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Appointments List with Actions -->
        <StackPanel Grid.Column="0" Margin="8">
            <Button Content="Refresh" Command="{Binding EditCommand}" Margin="0 0 0 8" />
            <Button Content="Add" Command="{Binding AddCommand}" Margin="0 0 0 8" />

            <ListBox ItemsSource="{Binding Appointments}"
                     SelectedItem="{Binding SelectedAppointment}"
                     DisplayMemberPath="DoctorName" />
        </StackPanel>

        <!-- Right Panel: Appointment Details -->
        <StackPanel Grid.Column="1" Margin="8" DataContext="{Binding SelectedAppointment}">

            <!-- Doctor ID (readonly) -->
            <TextBlock Text="Doctor ID" />
            <TextBox Text="{Binding DoctorId}" IsReadOnly="True" Background="#f5f5f5"/>

            <!-- First Name -->
            <TextBlock Text="First Name" Margin="0 8 0 0"/>
            <TextBox Text="{Binding FirstName, Mode=TwoWay}" />

            <!-- Last Name -->
            <TextBlock Text="Last Name" Margin="0 8 0 0"/>
            <TextBox Text="{Binding LastName, Mode=TwoWay}" />

            <!-- Patient Name -->
            <TextBlock Text="Patient Name" Margin="0 8 0 0"/>
            <TextBox Text="{Binding PatientName, Mode=TwoWay}" />

            <!-- Specialty -->
            <TextBlock Text="Specialty" Margin="0 8 0 0"/>
            <TextBox Text="{Binding Specialty, Mode=TwoWay}" />

            <!-- Delete Button -->
            <StackPanel Orientation="Horizontal" Margin="0 12 0 0">
                <Button Content="Delete"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
