<Window x:Class="MiranteDoctorAppointment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiranteDoctorAppointment"
        mc:Ignorable="d"
        Title="Doctor Appointment Manager" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Input Form -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,5,0">
            <StackPanel>
                <TextBlock Text="Add New Appointment" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <TextBlock Text="First Name:" Margin="0,5,0,2"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                
                <TextBlock Text="Last Name:" Margin="0,10,0,2"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                
                <TextBlock Text="Patient Name:" Margin="0,10,0,2"/>
                <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                
                <TextBlock Text="Specialty:" Margin="0,10,0,2"/>
                <TextBox Text="{Binding Specialty, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                
                <Button Content="Add Appointment" Command="{Binding AddCommand}" 
                        Margin="0,20,0,0" Padding="10" Background="#4CAF50" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                
                <Separator Margin="0,30,0,20"/>
                
                <TextBlock Text="Selected Appointment Actions" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <Button Content="Update Selected" Command="{Binding UpdateCommand}" 
                        Margin="0,5,0,5" Padding="10" Background="#2196F3" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                
                <Button Content="Delete Selected" Command="{Binding DeleteCommand}" 
                        Margin="0,5,0,0" Padding="10" Background="#F44336" 
                        Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Appointments List -->
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="5,0,0,0">
            <DockPanel>
                <TextBlock Text="Appointments List" FontSize="18" FontWeight="Bold" 
                          DockPanel.Dock="Top" Margin="0,0,0,10"/>
                
                <DataGrid ItemsSource="{Binding Appointments}" 
                         SelectedItem="{Binding SelectedAppointment}"
                         AutoGenerateColumns="False" 
                         CanUserAddRows="False"
                         AlternatingRowBackground="LightGray"
                         GridLinesVisibility="Horizontal"
                         HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding DoctorId}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                        <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
