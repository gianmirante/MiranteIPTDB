<Window x:Class="MiranteWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiranteWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF33777C">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Width="469" Background="#CCB14B4B" Margin="167,0,0,0" Height="300">
            <TextBlock Height="46" TextWrapping="Wrap" Text="WELCOME TO DOCTORS CLINIC" Width="413" Foreground="#FF7DFF00" FontFamily="Segoe UI Black" FontSize="24" TextAlignment="Center" FontWeight="Bold"/>
            <TextBlock Text="First Name:" Margin="5" FontWeight="Bold"/>
            <TextBox x:Name="Firstname" Margin="5"/>

            <TextBlock Text="Last Name:" Margin="5" FontWeight="Bold"/>
            <TextBox x:Name="Lastname" Margin="5"/>

            <TextBlock Text="Specialty:" Margin="5" FontWeight="Bold"/>
            <TextBox x:Name="Specialty" Margin="5"/>

            <TextBlock Text="Patient Name:" Margin="5" FontWeight="Bold"/>
            <TextBox x:Name="Patientname" Margin="5"/>

            <Button Content="Submit"
                    Margin="10"
                    Background="LightBlue"
                    Click="Button_Click"
                    Width="115"
                    HorizontalAlignment="Center">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.201"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </StackPanel>
    </Grid>
</Window>
